node_modules/
dist/
*.tgz
.DS_Store
release-build/
addons/*/renderer/

# The signed registry and built tarballs are NOT committed. While the repo was
# private a read-only PAT couldn't create Releases, so they were committed at
# the root and served over raw.githubusercontent.com for testing. That stops
# once the repo is public: publishing a registry signed by a test key whose
# private half is in this repo would be worse than publishing none. Real
# distribution goes through signed GitHub Releases — see the README GO-LIVE TODO.
addon-registry.json
addon-registry.json.sig

# Key material — never committed, in any form. Test keys included: a private
# key in a repo is a private key on the internet the moment the repo is public,
# and git history keeps it there afterwards. Test keys are generated offline by
# the same ceremony as production and kept outside any working tree.
*.pem
*.key
*.pub
*-signing-key.json
test-signing-key.json
